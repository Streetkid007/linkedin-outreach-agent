# Copy to .env and fill in. Never commit the real file.
# Credentials live here and in the workflow engine, never inside a prompt
# passed to the model, same boundary Alpgency proposed: the model returns
# judgments and drafts, it never touches a key.

AFFINITY_API_KEY=
UNIPILE_DSN=            # e.g. https://apiXX.unipile.com:XXXX
UNIPILE_API_KEY=

# One Unipile workspace (one DSN/API key above) can have several LinkedIn
# accounts connected to it. The agent picks which one to send from per
# company, based on Affinity's Owners field (see config/settings.py OWNERS).
UNIPILE_LINKEDIN_ACCOUNT_ID_JULIETTE=
UNIPILE_LINKEDIN_ACCOUNT_ID_HUGO=

# Anthropic API key for the thesis check and message composer steps.
# Not needed if this runs inside a Claude Code Remote scheduled task, which
# carries its own model access.
ANTHROPIC_API_KEY=
